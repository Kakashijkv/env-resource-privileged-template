+name: CI / Build & Deploy
+
+on:
+  push:
+    branches:
+      - '**'
+  pull_request:
+    branches:
+      - '**'
+
+permissions:
+  contents: read  # minimal permission for building and testing
+  id-token: write # if using OIDC to request cloud tokens (configure provider accordingly)
+
+env:
+  APP_IMAGE: ghcr.io/${{ github.repository_owner }}/env-resource-privileged-template:ci-${{ github.sha }}
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    outputs:
+      image: ${{ steps.set-image.outputs.image }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Set up Python 3.11
+        uses: actions/setup-python@v4
+        with:
+          python-version: "3.11"
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r app/requirements.txt
+
+      - name: Run tests
+        run: |
+          # Add your test commands here
+          echo "No tests configured"
+
+      - name: Build Docker image
+        run: |
+          docker build -t $APP_IMAGE ./app
+
+      - name: Set output image
+        id: set-image
+        run: echo "image=$APP_IMAGE" >> $GITHUB_OUTPUT
+
+  deploy:
+    needs: build
+    runs-on: ubuntu-latest
+    # choose environment based on branch: main -> production, otherwise staging
+    environment: ${{ github.ref == 'refs/heads/main' && 'production' || 'staging' }}
+    if: github.event_name == 'push' && (startsWith(github.ref, 'refs/heads/') )
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Deploy (example)
+        env:
+          IMAGE: ${{ needs.build.outputs.image }}
+        run: |
+          echo "Deploy step locked by GitHub Environment protections."
+          echo "IMAGE=$IMAGE"
+          # Example: push image to registry, then trigger deployment
+          # This step expects environment secrets to be configured (e.g. CLOUD_CRED, DEPLOY_KEY)
+          # Replace with your deploy tool (kubectl, terraform, etc.)
+          echo "Deploy commands go here"
+
+  terraform:
+    needs: build
+    runs-on: ubuntu-latest
+    environment: staging
+    if: github.event_name == 'push' && startsWith(github.ref, 'refs/heads/')
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Terraform
+        uses: hashicorp/setup-terraform@v2
+        with:
+          terraform_version: 1.5.0
+
+      - name: Terraform Init & Validate
+        env:
+          TF_VAR_example: "value"
+        run: |
+          cd infra || exit 0
+          terraform init -input=false
+          terraform validate || true
+          terraform plan -out=tfplan || true
+
+      - name: Upload plan artifact
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: terraform-plan
+          path: infra/tfplan
+
